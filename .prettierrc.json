{
    "singleQuote": true,
    "semi": true,
    "proseWrap": "always",
    "trailingComma": "all",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "htmlWhitespaceSensitivity": "ignore",
    "arrowParens": "always",
    "singleAttributePerLine": true,
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": false,
    "overrides": [
        {
            "files": ["./**/*.html", "./**/*.scss", "./**/*.css"],
            "options": {
                "printWidth": 120
            }
        }
    ]
}
